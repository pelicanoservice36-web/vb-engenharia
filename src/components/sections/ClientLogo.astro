---
import { Image } from 'astro:assets';
import type { Client } from '../../data/clients';

interface Props {
  client: Client;
}
const { client } = Astro.props;

// Largura calculada a partir da proporção real de cada logo (em vez de
// forçar um box width/height fixo) — evita que o Astro precise recortar
// logos com proporções muito diferentes entre si (ex.: "GrupoRB", bem mais
// largo que os demais, aparecia cortado quando width/height eram fixos).
const height = 96;
const width = Math.round(height * (client.logo.width / client.logo.height));
---

<div class="client-logo">
  <Image src={client.logo} alt={client.name} width={width} height={height} />
</div>

<style>
  .client-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 2.2 / 1;
    padding: var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .client-logo :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }
</style>
