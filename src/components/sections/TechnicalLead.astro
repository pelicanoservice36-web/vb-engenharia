---
// Bloco do responsável técnico. Sem fotografia real disponível — em vez de um
// placeholder tipo "foto em breve", usamos um monograma decorativo (não
// finge ser uma foto: fica aria-hidden, o nome já está no <h3> ao lado).
import { technicalLead } from '../../data/company';

const initials = technicalLead.name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<div class="technical-lead">
  <div class="technical-lead__badge" aria-hidden="true">
    <span class="technical-lead__ring"></span>
    <span class="technical-lead__initials">{initials}</span>
  </div>
  <div class="technical-lead__body">
    <p class="technical-lead__eyebrow">Responsável técnico</p>
    <h3>{technicalLead.name}</h3>
    <p class="technical-lead__role">{technicalLead.role}</p>
    <ul class="technical-lead__credentials">
      {technicalLead.credentials.map((credential) => (
        <li>{credential}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .technical-lead {
    margin-top: var(--space-2xl);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: center;
    background: var(--color-surface-alt);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .technical-lead__badge {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: var(--radius-pill);
    background: linear-gradient(155deg, var(--color-navy) 0%, #0d264f 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .technical-lead__ring {
    position: absolute;
    inset: 8px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-orange);
    opacity: 0.6;
  }

  .technical-lead__initials {
    font-family: var(--font-mono, monospace);
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-white);
  }

  .technical-lead__eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-orange-on-light);
    margin-bottom: var(--space-3xs);
  }

  .technical-lead__role {
    color: var(--color-gray-technical);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .technical-lead__credentials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
  }

  .technical-lead__credentials li {
    padding: var(--space-3xs) var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-navy);
  }

  @media (max-width: 560px) {
    .technical-lead {
      grid-template-columns: minmax(0, 1fr);
      text-align: center;
      justify-items: center;
    }
  }
</style>
