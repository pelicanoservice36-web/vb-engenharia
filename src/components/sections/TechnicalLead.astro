---
// Bloco do responsável técnico. Sem foto — não existe uma foto profissional
// documentada para usar, e o briefing é explícito em não inventar biografia.
// O placeholder fica pronto para receber uma foto real no futuro.
import { technicalLead } from '../../data/company';
---

<div class="technical-lead">
  <div class="technical-lead__photo" role="img" aria-label={`Foto de ${technicalLead.name} (a adicionar)`}>
    <span aria-hidden="true">Foto em breve</span>
  </div>
  <div class="technical-lead__body">
    <p class="technical-lead__eyebrow">Responsável técnico</p>
    <h3>{technicalLead.name}</h3>
    <p class="technical-lead__role">{technicalLead.role}</p>
    <ul class="technical-lead__credentials">
      {technicalLead.credentials.map((credential) => (
        <li>{credential}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .technical-lead {
    margin-top: var(--space-2xl);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-lg);
    align-items: center;
    background: var(--color-surface-alt);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .technical-lead__photo {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-pill);
    background: var(--color-navy);
    color: var(--color-gray-on-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: var(--fs-small);
    flex-shrink: 0;
    border: 2px dashed var(--color-border-on-navy);
  }

  .technical-lead__eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-orange-on-light);
    margin-bottom: var(--space-3xs);
  }

  .technical-lead__role {
    color: var(--color-gray-technical);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .technical-lead__credentials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
  }

  .technical-lead__credentials li {
    padding: var(--space-3xs) var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-navy);
  }

  @media (max-width: 560px) {
    .technical-lead {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
  }
</style>
