---
// Fragmento (sem <section> própria) — usado dentro de About.astro, na
// seção "Empresa", que já fornece o <h2> da página.
import TabAccordion from '../ui/TabAccordion.astro';
import Icon from '../icons/Icon.astro';
import { missionVisionValues } from '../../data/company';
---

<div class="mvv">
  <h3 class="mvv__heading">Missão, visão e valores</h3>
  <TabAccordion groupLabel="Missão, visão e valores">
    {missionVisionValues.map((item, i) => (
      <details class="tab-accordion__item" data-tab-item data-id={item.id} open={i === 0}>
        <summary class="tab-accordion__summary" data-tab-trigger>
          <Icon name={item.icon} size={20} />
          <span>{item.title}</span>
          <Icon name="chevron-down" size={18} class="tab-accordion__chevron" />
        </summary>
        <div class="tab-accordion__panel" data-tab-panel>
          {Array.isArray(item.content) ? (
            <ul class="mvv__values">
              {item.content.map((value) => (
                <li>
                  <Icon name="check" size={14} />
                  <span>{value}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mvv__text">{item.content}</p>
          )}
        </div>
      </details>
    ))}
  </TabAccordion>
</div>

<style>
  .mvv {
    margin-top: var(--space-2xl);
  }

  .mvv__heading {
    margin-bottom: var(--space-md);
  }

  .mvv__text {
    color: var(--color-gray-technical);
    font-size: var(--fs-lead);
  }

  .mvv__values {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .mvv__values li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
    color: var(--color-gray-technical);
  }

  .mvv__values :global(svg) {
    color: var(--color-blue-electric);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
</style>
