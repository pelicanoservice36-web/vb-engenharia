---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import HeroVisual from './HeroVisual.astro';
import TechnicalLead from './TechnicalLead.astro';
import MissionVisionValues from './MissionVisionValues.astro';
import { about } from '../../data/company';
---

<section class="about" id="empresa" aria-labelledby="about-title">
  <Container>
    <SectionHeading id="about-title" index={8} eyebrow="Empresa" title={about.title} />

    <div class="about__inner">
      <div class="about__text">
        {about.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <HeroVisual class="about__visual" />
    </div>

    <TechnicalLead />
    <MissionVisionValues />
  </Container>
</section>

<style>
  .about {
    padding-block: var(--space-2xl);
    background: var(--color-surface);
  }

  .about__inner {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: var(--space-xl);
  }

  .about__text p + p {
    margin-top: var(--space-sm);
  }

  .about__text p {
    color: var(--color-gray-technical);
  }

  @media (max-width: 900px) {
    .about__inner {
      grid-template-columns: 1fr;
    }

    :global(.about__visual) {
      order: -1;
      max-width: 280px;
    }
  }
</style>
