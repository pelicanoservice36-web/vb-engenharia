---
import Icon from '../icons/Icon.astro';
import type { Differential } from '../../data/company';

interface Props {
  differential: Differential;
  index: number;
}
const { differential, index } = Astro.props;
---

<article class="differential" data-reveal>
  <div class="differential__icon">
    <Icon name={differential.icon} size={26} />
  </div>
  <div>
    <p class="differential__index" aria-hidden="true">{String(index).padStart(2, '0')}</p>
    <h3>{differential.title}</h3>
    <p>{differential.description}</p>
  </div>
</article>

<style>
  .differential {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .differential__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--color-border-on-navy);
    color: var(--color-orange);
  }

  .differential__index {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-orange);
    margin-bottom: var(--space-3xs);
  }

  .differential h3 {
    color: var(--color-white);
    font-size: 1.1rem;
    margin-bottom: var(--space-3xs);
  }

  .differential p {
    color: var(--color-gray-on-navy);
    font-size: var(--fs-small);
  }
</style>
