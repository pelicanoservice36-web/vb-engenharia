---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import HeroBackgroundVideo from './HeroBackgroundVideo.astro';
import { hero } from '../../data/hero';
---

<section class="hero" id="inicio" aria-label="Apresentação">
  <HeroBackgroundVideo class="hero__video" />
  <div class="hero__overlay hero__overlay--x" aria-hidden="true"></div>
  <div class="hero__overlay hero__overlay--y" aria-hidden="true"></div>
  <Container>
    <div class="hero__content">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title}</h1>
      <p class="hero__subtitle">{hero.subtitle}</p>
      <div class="hero__ctas">
        <Button href={hero.primaryCta.href} variant="primary">{hero.primaryCta.label}</Button>
        <Button href={hero.secondaryCta.href} variant="secondary">{hero.secondaryCta.label} ↓</Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-navy);
    color: var(--color-white);
    padding-block: var(--space-2xl) var(--space-xl);
    min-height: 82vh;
    display: flex;
    align-items: center;
  }

  /* Escurece mais à esquerda (onde o texto fica) e menos à direita (onde o
     vídeo fica mais visível) — mesmo modelo de clinica-samya.pelicanoservice36.workers.dev. */
  .hero__overlay--x {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(10, 31, 68, 0.94) 0%,
      rgba(10, 31, 68, 0.72) 45%,
      rgba(10, 31, 68, 0.32) 100%
    );
  }

  .hero__overlay--y {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(10, 31, 68, 0.7) 0%, rgba(10, 31, 68, 0) 55%, rgba(10, 31, 68, 0) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 42rem;
  }

  .hero .eyebrow {
    color: var(--color-orange);
  }

  .hero__content h1 {
    color: var(--color-white);
    margin-block: var(--space-sm);
  }

  .hero__subtitle {
    font-size: var(--fs-lead);
    color: var(--color-gray-on-navy);
    max-width: 52ch;
    margin-bottom: var(--space-lg);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
