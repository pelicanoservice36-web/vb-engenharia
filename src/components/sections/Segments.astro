---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import SegmentCard from './SegmentCard.astro';
import { segments } from '../../data/segments';
---

<section class="segments" id="solucoes" aria-labelledby="segments-title">
  <Container>
    <SectionHeading
      id="segments-title"
      index={3}
      eyebrow="Soluções"
      title="Soluções para diferentes necessidades"
      subtitle="Industrial, comercial ou predial: cada segmento tem suas próprias exigências técnicas."
      align="center"
    />
    <div class="segments__list">
      {segments.map((segment, i) => (
        <SegmentCard segment={segment} reverse={i % 2 === 1} />
      ))}
    </div>
  </Container>
</section>

<style>
  .segments {
    padding-block: var(--space-2xl);
    background: var(--color-surface);
  }

  .segments :global(h2) {
    margin-inline: auto;
  }

  .segments__list {
    margin-top: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }
</style>
