---
// Vídeo institucional fornecido pela empresa (Video/Video-VB-Engenharia.mp4),
// recodificado para web (public/videos/vb-engenharia-hero.mp4 — sem áudio,
// já que toca mudo; ver hero-video.ts para a lógica de autoplay). Sem
// JavaScript, ou com prefers-reduced-motion, o <video> fica parado no poster
// (primeiro frame) — nunca reproduz automaticamente por conta própria.
import { getImage } from 'astro:assets';
import posterSrc from '../../assets/images/hero/vb-engenharia-hero-poster.jpg';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const poster = await getImage({ src: posterSrc, width: 960, format: 'jpg' });
---

<div class:list={['hero-visual', className]} aria-hidden="true">
  <video
    class="hero-visual__video"
    data-hero-video
    src="/videos/vb-engenharia-hero.mp4"
    poster={poster.src}
    muted
    loop
    playsinline
    preload="metadata"
  ></video>
</div>

<style>
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin-inline: auto;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-border-on-navy);
    background: var(--color-navy);
  }

  .hero-visual__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% center;
  }
</style>
